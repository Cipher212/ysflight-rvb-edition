YFSVERSI 20141101
SIMTITLE "RvB AI landing test over Luavi"
FIELDNAM [RVB]LUAVI 0 0 0 0 0 0 TRUE
ALLOWAAM TRUE
ALLOWGUN TRUE
ALLOWAGM TRUE
ALLOWBOM TRUE
ALLOWRKT TRUE

AIRPLANE "F-16(BLUE/MULTIROLE)" TRUE
IDENTIFY 0
AIRPCMND POSITION -14000.0m 1500.0m 16000.0m
AIRPCMND ATTITUDE 0.0deg 0.0deg 0.0deg
AIRPCMND INITSPED 180.0m/s
AIRPCMND CTLTHROT 0.8
AIRPCMND CTLLDGEA FALSE
AIRPCMND INITFUEL 4%

AIRPLANE "TORNADO(BLUE/ATTACKER)" FALSE
IDENTIFY 0
AIRPCMND POSITION -30000.0m 1200.0m -8000.0m
AIRPCMND ATTITUDE 0.0deg 0.0deg 0.0deg
AIRPCMND INITSPED 180.0m/s
AIRPCMND CTLTHROT 0.8
AIRPCMND CTLLDGEA FALSE
AIRPCMND INITFUEL 4%
INTENTIO
MINIALTI 400
DOGFIGHT G7.00 B15.00
ENDINTEN
LANDLWFL 0.00

AIRPLANE "MIG-29(RED/MULTIROLE)" FALSE
IDENTIFY 3
AIRPCMND POSITION 12000.0m 1500.0m 16000.0m
AIRPCMND ATTITUDE 0.0deg 0.0deg 0.0deg
AIRPCMND INITSPED 180.0m/s
AIRPCMND CTLTHROT 0.8
AIRPCMND CTLLDGEA FALSE
AIRPCMND INITFUEL 4%
INTENTIO
MINIALTI 400
DOGFIGHT G7.00 B15.00
ENDINTEN
LANDLWFL 0.00
