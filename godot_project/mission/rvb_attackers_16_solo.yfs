YFSVERSI 20141101
SIMTITLE "16 blue attackers vs live enemy and neutral ground targets"
FIELDNAM [RVB]LUAVI 0 0 0 0 0 0 TRUE
ALLOWAAM TRUE
ALLOWGUN TRUE
ALLOWAGM TRUE
ALLOWBOM TRUE
ALLOWRKT TRUE

AIRPLANE "JAGUAR(BLUE/ATTACKER)" TRUE
IDENTIFY 0
AIRPCMND POSITION -13500.0m 600.0m -5200.0m
AIRPCMND ATTITUDE -90.0deg 0.0deg 0.0deg
AIRPCMND INITSPED 220.0m/s
AIRPCMND CTLTHROT 0.85
AIRPCMND CTLLDGEA FALSE
AIRPCMND INITFUEL 100%
AIRPCMND UNLOADWP
AIRPCMND LOADWEPN AGM65 2
AIRPCMND LOADWEPN B500 2
AIRPCMND LOADWEPN AIM9 2
AIRPCMND LOADWEPN FLARE 80
AIRPCMND LOADWEPN FUELTANK 1000
INTENTIO
MINIALTI 300
DOGFIGHT G7.00 B15.00
ENDINTEN

