YFSVERSI 20141101
SIMTITLE "RvB combat fixture"
FIELDNAM [RVB]LUAVI 0 0 0 0 0 0 TRUE
ALLOWAAM TRUE
ALLOWGUN TRUE
ALLOWAGM TRUE
ALLOWBOM TRUE
ALLOWRKT TRUE
DSABLGND

AIRPLANE "F-16(BLUE/MULTIROLE)" TRUE
IDENTIFY 0
AIRPCMND POSITION -12500.0m 500.0m 9000.0m
