IDENTIFY [GOP]TRUCK
HTRADIUS 10m
STRENGTH 5
INITIGUN 0
INITISAM 0
MAXSPEED 100km/h
MAXROTAT 60deg
MINAIMPI 0deg
MAXAIMPI 0deg
AIMROTAT 0deg
AIMPITCH 0deg
ANTIGRND TRUE
HUGROUND TRUE
GUNRANGE 0m
SAMRANGE 0m
MINIDAMG 0
SPLYAMMO TRUE
SPLYFUEL TRUE
GRNDTYPE VEHICLE

USEAIMAT 0m 2m 0m

REM RVB_PRIORITY 1
REM RVB_HITS_BOMB 1
REM RVB_HITS_AGM 1
REM RVB_HITS_ROCKET 1
REM RVB_HITS_GUN 5
