IDENTIFY [GOP]HYUGA_CLASS
HTRADIUS 195m
STRENGTH 100
INITIGUN 999999999
INITISAM 999999999
MAXSPEED 0kt
MAXROTAT 3deg
MINAIMPI 0deg
MAXAIMPI 0deg
CARRIER User/gop/CV/16DDH.acp
SPLYFUEL TRUE
SPLYAMMO TRUE

ANTIGRND TRUE

AIMROTAT 60deg
AIMPITCH 60deg

GUNRANGE 1000m
AAAMINPI -3deg
AAAMAXPI 40deg
AAAMOUNT 11.0000m 20.00m 26.00m

SAMRANGE 3000m
SAMMINPI 10deg
SAMMAXPI 90deg
SAMMOUNT 9.0000m 15m -77.00m

MINIDAMG 8

REM RVB_PRIORITY 3
REM RVB_HITS_BOMB 2
REM RVB_HITS_AGM 9
REM RVB_HITS_ROCKET 10
REM RVB_HITS_GUN IMPERVIOUS
