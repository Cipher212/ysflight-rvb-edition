; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="YSFlight Godot Port"
run/main_scene="res://ui/home.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[shader_globals]

sun_direction={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
sky_haze={
"type": "vec3",
"value": Vector3(0.6, 0.7, 0.8)
}
cloud_shadows_on={
"type": "float",
"value": 1.0
}
water_shine_on={
"type": "float",
"value": 1.0
}
ground_detail_on={
"type": "float",
"value": 1.0
}
daylight_strength={
"type": "float",
"value": 1.0
}
