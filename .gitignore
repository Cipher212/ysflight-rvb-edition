# Build artifacts
*.obj
*.pdb
*.map
*.ilk
*.exp
*.lib
.sconsign.dblite
gdextension/ysflight/scons_debug.txt
gdextension/ysflight/bin/

# Godot cache (recreated on first start)
godot_project/.godot/

# Godot runtime downloaded by tools/get_godot.bat
/engine/

# Runtime logs, benchmark output, Python cache
/crashlog/
__pycache__/
*.pyc
*.lnk

# Godot-side runtime logs and dated scenery backups (rollback copies stay local)
godot_project/crashlog/
godot_project/user/**/*.fld.bak
godot_project/user/**/*.stp.bak
